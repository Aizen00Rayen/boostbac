{
  "expo": {
    "name": "BoostBac",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "boostbac",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.bacailearn.dttpl0",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan your notes to auto-create flashcards",
        "NSPhotoLibraryUsageDescription": "Upload note photos to create flashcards"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0797A3"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.bacailearn.dttpl0",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan your notes to auto-create flashcards"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload note photos to create flashcards"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/boostbac.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F7F2"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99a90a18-bbfd-49b9-bf7f-566fbccf87d3"
      }
    },
    "owner": "rayenaizen"
  }
}
